---
import Layout from '../../layouts/Layout.astro';
import Hero from '../../components/Hero.astro';
import ProjectsSection from '../../components/ProjectsSection.astro';
import PathSection from '../../components/PathSection.astro';
import OpenSourceSection from '../../components/OpenSourceSection.astro';
import CommunitySection from '../../components/CommunitySection.astro';
import SkillsDensity from '../../components/SkillsDensity.astro';
import { t } from '../../i18n/ui';

const locale = 'es' as const;
const dict = t(locale);
---

<Layout
  locale={locale}
  title="Daniel V. Millares, PhD — Bioinformatics Platform Tech Lead"
  description={dict.heroP}
>
  <main id="top">
    <div style="max-width:1180px;margin:0 auto;padding:0 28px">
      <Hero dict={dict} lang={locale} />
    </div>
    <SkillsDensity lang={locale} n="01" kicker={dict.navStack} title={dict.stackTitle} levels={dict.levels} keywords={dict.keywords} />
    <div style="max-width:1180px;margin:0 auto;padding:0 28px">
      <ProjectsSection locale={locale} dict={dict} />
      <PathSection locale={locale} dict={dict} />
      <OpenSourceSection locale={locale} dict={dict} />
      <CommunitySection locale={locale} dict={dict} />
    </div>
  </main>
</Layout>
