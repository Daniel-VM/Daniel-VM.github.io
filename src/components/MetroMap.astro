---
import { lines, stations, type Lang } from '../data/profile';

interface Props {
  lang: Lang;
  caption: string;
}
const { lang, caption } = Astro.props;
const legend = lines.filter((l) => !l.id.endsWith('-next'));
const external = (href?: string) => !!href && /^https?:/.test(href);
---

<figure class="metro" aria-label={caption}>
  <div class="metro-scroll">
    <svg viewBox="0 0 1060 360" role="img" aria-labelledby="metro-title" class="metro-svg">
      <title id="metro-title">{caption}</title>
      <g class="metro-lines" fill="none" stroke-linecap="round" stroke-linejoin="round">
        {lines.map((l) => (
          <path
            d={l.d}
            stroke={l.color}
            stroke-width="7"
            pathLength="1"
            class:list={['metro-line', { dashed: l.dashed }]}
            data-line={l.id.replace('-next', '')}
          />
        ))}
      </g>
      <g class="metro-train" aria-hidden="true">
        {lines.filter((l) => !l.dashed).map((l, i) => (
          <circle r="4.5" fill="#fff" stroke={l.color} stroke-width="2.5" opacity="0">
            <set attributeName="opacity" to="1" begin={`${1.6 + i * 0.7}s`} />
            <animateMotion dur={`${9 + i * 2}s`} begin={`${1.6 + i * 0.7}s`} repeatCount="indefinite" path={l.d} />
          </circle>
        ))}
      </g>
      <g class="metro-stations">
        {stations.map((s) => {
          const label = s.label[lang];
          const ty = s.pos === 'below' ? s.y + 30 : s.y - 22;
          const body = (
            <>
              <circle
                cx={s.x}
                cy={s.y}
                r={s.interchange ? 14 : 8}
                class:list={['st-dot', { future: s.future, interchange: s.interchange }]}
              />
              <text x={s.x} y={ty} text-anchor="middle" class:list={['st-label', { strong: s.interchange }]}>
                {label}
                {external(s.href) ? ' ↗' : ''}
              </text>
            </>
          );
          return s.href ? (
            <a
              href={s.href}
              class="station"
              data-station={s.id}
              target={external(s.href) ? '_blank' : undefined}
              rel={external(s.href) ? 'noopener' : undefined}
            >
              {body}
            </a>
          ) : (
            <g class="station is-static" data-station={s.id}>
              {body}
            </g>
          );
        })}
      </g>
    </svg>
  </div>
  <figcaption class="metro-legend">
    {legend.map((l) => (
      <button type="button" class="legend-item" data-legend={l.id}>
        <span style={`background:${l.color}`}></span>{l.name[lang]}
      </button>
    ))}
  </figcaption>
</figure>

<style>
  .metro { margin: 0; }
  .metro-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .metro-svg { display: block; width: 100%; min-width: 760px; height: auto; }

  .metro-line {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    animation: draw 1.6s var(--ease) forwards;
    transition: opacity var(--duration) var(--ease);
  }
  .metro-line.dashed { stroke-dasharray: 0.06 0.06; stroke-dashoffset: 0; stroke-width: 5; opacity: 0; animation: fade-in .6s 1.4s var(--ease) forwards; }
  @keyframes draw { to { stroke-dashoffset: 0; } }
  @keyframes fade-in { to { opacity: 1; } }

  .st-dot {
    fill: var(--color-bg);
    stroke: var(--color-text);
    stroke-width: 3.5;
    transition: transform var(--duration) var(--ease), fill var(--duration) var(--ease);
    transform-box: fill-box;
    transform-origin: center;
  }
  .st-dot.interchange { stroke-width: 5; }
  .st-dot.future { stroke-dasharray: 3 3; stroke: #7b5ea7; }
  .st-label {
    font: 500 14px/1 var(--font-body);
    fill: var(--color-neutral-800);
    transition: fill var(--duration) var(--ease);
  }
  .st-label.strong { font-weight: 700; fill: var(--color-text); font-size: 15px; }
  .station:not(.is-static) { cursor: pointer; }
  .station:hover .st-dot, .station:focus-visible .st-dot { transform: scale(1.35); fill: var(--color-accent-200); }
  .station:hover .st-label, .station:focus-visible .st-label { fill: var(--color-accent-700); text-decoration: underline; }
  .station:focus-visible { outline: none; }

  .metro.has-focus .metro-line:not(.on) { opacity: 0.15; }

  .metro-legend { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 10px; }
  .legend-item {
    all: unset; cursor: pointer;
    display: inline-flex; align-items: center; gap: 8px;
    font: 400 11px/1 ui-monospace, Menlo, monospace; letter-spacing: .08em; text-transform: uppercase;
    color: var(--color-neutral-700);
  }
  .legend-item span { width: 22px; height: 5px; border-radius: 3px; display: inline-block; }
  .legend-item:hover, .legend-item:focus-visible { color: var(--color-text); }

  @media (prefers-reduced-motion: reduce) {
    .metro-line, .metro-line.dashed { animation: none; stroke-dashoffset: 0; opacity: 1; }
    .metro-train { display: none; }
  }
</style>

<script>
  function initMetro() {
    document.querySelectorAll<HTMLElement>('.metro').forEach((fig) => {
      const set = (id: string | null) => {
        fig.classList.toggle('has-focus', !!id);
        fig.querySelectorAll<SVGPathElement>('.metro-line').forEach((p) => p.classList.toggle('on', p.dataset.line === id));
      };
      fig.querySelectorAll<HTMLElement>('[data-legend]').forEach((b) => {
        b.addEventListener('mouseenter', () => set(b.dataset.legend ?? null));
        b.addEventListener('focus', () => set(b.dataset.legend ?? null));
        b.addEventListener('mouseleave', () => set(null));
        b.addEventListener('blur', () => set(null));
      });
    });
    // Station links to a project card: show all projects and flash the target card.
    document.querySelectorAll<HTMLAnchorElement>('.station[href^="#p-"]').forEach((a) => {
      a.addEventListener('click', () => {
        const all = document.querySelector<HTMLInputElement>('[data-project-filter][value="all"]');
        if (all && !all.checked) { all.checked = true; all.dispatchEvent(new Event('change', { bubbles: true })); }
        const target = document.getElementById(a.getAttribute('href')!.slice(1));
        if (target) {
          target.classList.remove('flash');
          void target.offsetWidth;
          target.classList.add('flash');
        }
      });
    });
  }
  initMetro();
  document.addEventListener('astro:after-swap', initMetro);
</script>
