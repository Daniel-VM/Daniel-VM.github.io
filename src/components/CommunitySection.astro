---
import { getCollection } from 'astro:content';
import SectionKicker from './SectionKicker.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  dict: ReturnType<typeof import('../i18n/ui').t>;
}

const { locale, dict } = Astro.props;
const es = locale === 'es';

const talks = (await getCollection('talks')).sort((a, b) => a.id.localeCompare(b.id));
const courses = (await getCollection('courses')).sort((a, b) => a.id.localeCompare(b.id));
---

<section id="comunidad" class="reveal" style="padding:56px 0;border-top:1px solid var(--color-divider)">
  <SectionKicker n="05" label={dict.navCom} />
  <h2 style="font-size:clamp(30px,3.6vw,44px);margin:0 0 30px;letter-spacing:-.015em">{dict.comTitle}</h2>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(272px,1fr));gap:20px;margin-bottom:44px">
    {talks.map((c) => (
      <article class="card blueprint talk-card hover-lift" style="padding:0;gap:0;overflow:hidden">
        <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
        {c.data.media.kind === 'cover' && (
          <div class="media-box" style="aspect-ratio:4/3;overflow:hidden;border-bottom:1px solid var(--color-divider-soft);background:var(--color-neutral-100)">
            <img class="media-img" src={`/assets/${c.data.media.src}`} alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:top center;display:block" />
          </div>
        )}
        {c.data.media.kind === 'contain' && (
          <div style="aspect-ratio:4/3;overflow:hidden;border-bottom:1px solid var(--color-divider-soft);background:var(--color-bg);padding:12px">
            <img src={`/assets/${c.data.media.src}`} alt="" loading="lazy" style="width:100%;height:100%;object-fit:contain;display:block" />
          </div>
        )}
        {c.data.media.kind === 'duo' && (
          <div class="duotone media-box" style="aspect-ratio:4/3;overflow:hidden;border-bottom:1px solid var(--color-divider-soft);background:var(--color-neutral-100)">
            <img class="media-img" src={`/assets/${c.data.media.src}`} alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:top center;display:block" />
          </div>
        )}
        <div style="padding:16px 17px 18px;display:flex;flex-direction:column;gap:9px">
          <span class="card-kicker" style="font-size:10px;letter-spacing:.11em">{es ? c.data.kindEs : c.data.kindEn} · {c.data.year}</span>
          <h3 class="card-title" style="font-size:17.5px">{c.data.title}</h3>
          <p style="font:400 11.5px/1.4 ui-monospace,Menlo,monospace;color:var(--color-neutral-700);margin:0">{c.data.where}</p>
          <p class="card-body" style="font-size:13px;line-height:1.5">{es ? c.data.textEs : c.data.textEn}</p>
        </div>
      </article>
    ))}
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,290px),1fr));gap:44px;align-items:start">
    <div>
      <h3 style="font-size:25px;margin:0 0 10px">{dict.trainTitle}</h3>
      <p style="font-size:14px;line-height:1.6;color:var(--color-neutral-700);margin:0 0 14px">{dict.trainSub}</p>
      <a
        class="btn btn-secondary"
        href="https://new.bioinformaticskillshub.com/courses/"
        target="_blank"
        rel="noopener"
        style="padding:10px 16px;font-size:13px;letter-spacing:.06em;text-transform:uppercase"
      >
        {dict.trainCta} ↗
      </a>
    </div>
    <div class="blueprint" style="overflow-x:auto">
      <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
      <table class="table" style="min-width:420px">
        <thead>
          <tr>
            <th class="table-head" style="padding:10px 16px">{dict.thCourse}</th>
            <th class="table-head" style="width:24%;padding:10px 16px">{dict.thWhere}</th>
            <th class="table-head" style="width:18%;padding:10px 16px">{dict.thHours}</th>
          </tr>
        </thead>
        <tbody>
          {courses.map((c) => (
            <tr class="course-row">
              <td style="padding:14px 16px;font:500 14.5px/1.35 var(--font-heading);letter-spacing:-.005em">{es ? c.data.nameEs : c.data.nameEn}</td>
              <td style="padding:14px 16px;font-size:12.5px;font-family:ui-monospace,Menlo,monospace;color:var(--color-neutral-700)">{c.data.where}</td>
              <td style="padding:14px 16px">
                <span
                  class={c.data.status === 'prep' ? 'tag' : 'tag tag-accent'}
                  style={
                    c.data.status === 'prep'
                      ? 'font:400 10.5px/1 ui-monospace,Menlo,monospace;padding:3px 10px;border:1px dashed var(--color-divider);color:var(--color-neutral-600)'
                      : 'font:400 10.5px/1 ui-monospace,Menlo,monospace;padding:3px 10px'
                  }
                >
                  {es ? c.data.hoursEs : c.data.hoursEn}
                </span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .media-img {
    transition: transform 0.4s var(--ease);
  }
  .talk-card:hover .media-img {
    transform: scale(1.05);
  }
  .table-head {
    text-align: left;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-700);
    border-bottom: 2px solid var(--color-accent) !important;
  }
  .course-row td {
    border-bottom: 1px solid var(--color-divider-faint);
    transition: background 0.15s;
  }
  .course-row:last-child td { border-bottom: none; }
  .course-row:hover td { background: color-mix(in srgb, var(--color-accent) 5%, transparent); }
</style>
