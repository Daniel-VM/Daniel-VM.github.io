---
import { getCollection } from 'astro:content';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  dict: ReturnType<typeof import('../i18n/ui').t>;
}

const { locale, dict } = Astro.props;
const es = locale === 'es';

const talks = (await getCollection('talks')).sort((a, b) => a.id.localeCompare(b.id));
const courses = (await getCollection('courses')).sort((a, b) => a.id.localeCompare(b.id));
---

<section id="comunidad" class="reveal" style="padding:56px 0;border-top:1px solid var(--color-divider)">
  <p style="font:400 11px/1 ui-monospace,Menlo,monospace;letter-spacing:.18em;text-transform:uppercase;color:var(--color-accent);margin:0 0 10px">
    05 / {dict.navCom}
  </p>
  <h2 style="font-size:clamp(30px,3.6vw,44px);margin:0 0 30px;letter-spacing:-.015em">{dict.comTitle}</h2>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(272px,1fr));gap:20px;margin-bottom:44px">
    {talks.map((c) => (
      <article class="card blueprint talk-card" style="padding:0;gap:0;overflow:hidden;transition:border-color .25s,box-shadow .25s">
        <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
        {c.data.media.kind === 'cover' && (
          <div style="aspect-ratio:4/3;overflow:hidden;border-bottom:1px solid var(--color-divider-soft);background:var(--color-neutral-100)">
            <img src={`/assets/${c.data.media.src}`} alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:top center;display:block" />
          </div>
        )}
        {c.data.media.kind === 'contain' && (
          <div style="aspect-ratio:4/3;overflow:hidden;border-bottom:1px solid var(--color-divider-soft);background:var(--color-bg);padding:12px">
            <img src={`/assets/${c.data.media.src}`} alt="" loading="lazy" style="width:100%;height:100%;object-fit:contain;display:block" />
          </div>
        )}
        {c.data.media.kind === 'duo' && (
          <div class="duotone" style="aspect-ratio:4/3;overflow:hidden;border-bottom:1px solid var(--color-divider-soft);background:var(--color-neutral-100)">
            <img src={`/assets/${c.data.media.src}`} alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:top center;display:block" />
          </div>
        )}
        <div style="padding:16px 17px 18px;display:flex;flex-direction:column;gap:9px">
          <span class="card-kicker" style="font-size:10px;letter-spacing:.11em">{es ? c.data.kindEs : c.data.kindEn} · {c.data.year}</span>
          <h3 class="card-title" style="font-size:17.5px">{c.data.title}</h3>
          <p style="font:400 11.5px/1.4 ui-monospace,Menlo,monospace;color:var(--color-neutral-700);margin:0">{c.data.where}</p>
          <p class="card-body" style="font-size:13px;line-height:1.5">{es ? c.data.textEs : c.data.textEn}</p>
        </div>
      </article>
    ))}
  </div>

  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,290px),1fr));gap:44px;align-items:start">
    <div>
      <h3 style="font-size:25px;margin:0 0 10px">{dict.trainTitle}</h3>
      <p style="font-size:14px;line-height:1.6;color:var(--color-neutral-700);margin:0 0 14px">{dict.trainSub}</p>
      <a
        class="btn btn-secondary"
        href="https://new.bioinformaticskillshub.com/courses/"
        target="_blank"
        rel="noopener"
        style="padding:10px 16px;font-size:13px;letter-spacing:.06em;text-transform:uppercase"
      >
        {dict.trainCta} ↗
      </a>
    </div>
    <table class="table">
      <thead>
        <tr>
          <th style="padding:var(--space-2)">{dict.thCourse}</th>
          <th style="width:22%;padding:var(--space-2)">{dict.thWhere}</th>
          <th style="width:14%;padding:var(--space-2)">{dict.thHours}</th>
        </tr>
      </thead>
      <tbody>
        {courses.map((c) => (
          <tr>
            <td style="padding:12px 8px;font-size:14px">{es ? c.data.nameEs : c.data.nameEn}</td>
            <td style="padding:12px 8px;font-size:13px;color:var(--color-neutral-700)">{c.data.where}</td>
            <td style="padding:12px 8px">
              <span class="tag tag-neutral" style="font:400 10.5px/1 ui-monospace,Menlo,monospace;padding:3px 10px">{es ? c.data.hoursEs : c.data.hoursEn}</span>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .talk-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }
</style>
