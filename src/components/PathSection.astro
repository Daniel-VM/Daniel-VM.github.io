---
import { getCollection } from 'astro:content';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  dict: ReturnType<typeof import('../i18n/ui').t>;
}

const { locale, dict } = Astro.props;
const es = locale === 'es';

const road = (await getCollection('roadmap')).sort((a, b) => a.id.localeCompare(b.id));
---

<section id="trayectoria" class="reveal" style="padding:66px 0 56px">
  <p style="font:400 11px/1 ui-monospace,Menlo,monospace;letter-spacing:.18em;text-transform:uppercase;color:var(--color-accent);margin:0 0 10px">
    03 / {dict.navRoad}
  </p>
  <h2 style="font-size:clamp(30px,3.6vw,44px);margin:0 0 6px;letter-spacing:-.015em">{dict.roadTitle}</h2>
  <p style="max-width:56ch;font-size:14.5px;line-height:1.6;color:var(--color-neutral-700);margin:0 0 34px">{dict.roadSub}</p>

  <div tabindex="0" role="group" aria-label={dict.roadTitle} style="overflow-x:auto;padding:6px 0 10px">
    <div style="display:grid;grid-template-columns:repeat(6,minmax(196px,1fr));min-width:1210px">
      {road.map((r, i) => {
        const row = i % 2 === 0 ? 1 : 3;
        const align = i % 2 === 0 ? 'end' : 'start';
        const isRecent = i >= road.length - 2;
        return (
          <div style="display:grid;grid-template-rows:1fr 30px 1fr">
            <div
              class="blueprint path-card"
              style={`grid-row:${row};align-self:${align};margin:0 11px;padding:15px 16px;background:transparent;transition:border-color .25s,box-shadow .25s`}
            >
              <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
              <div style="font:400 10.5px/1 ui-monospace,Menlo,monospace;letter-spacing:.1em;color:var(--color-accent);margin-bottom:8px">
                {es ? r.data.yearEs : r.data.yearEn}
              </div>
              <div style="font:600 21px/1.1 var(--font-heading)">{r.data.place}</div>
              <div style="font:500 12.5px/1.35 var(--font-body);color:var(--color-neutral-800);margin-top:3px">
                {es ? r.data.roleEs : r.data.roleEn}
              </div>
              <div style="font-size:12.5px;line-height:1.5;color:var(--color-neutral-700);margin-top:8px">
                {es ? r.data.detailEs : r.data.detailEn}
              </div>
            </div>
            <div
              style="grid-row:2;display:grid;place-items:center;background:linear-gradient(to bottom,transparent 14px,var(--color-neutral-300) 14px,var(--color-neutral-300) 15px,transparent 15px)"
            >
              <span
                style={
                  isRecent
                    ? 'width:13px;height:13px;background:var(--color-accent);box-shadow:0 0 0 4px var(--color-bg),0 0 0 6px color-mix(in srgb, var(--color-accent) 35%, transparent)'
                    : 'width:11px;height:11px;background:var(--color-accent);box-shadow:0 0 0 4px var(--color-bg)'
                }
              ></span>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .path-card:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-md);
  }
</style>
