---
interface Props {
  name: 'coralis';
  label?: string;
}

const { name } = Astro.props;
---

<svg viewBox="0 0 316 144" width="100%" height="100%" role="img" aria-hidden="true" class="card-illustration">
  <defs>
    <marker id={`arrow-${name}`} viewBox="0 0 8 8" refX="6" refY="4" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
      <path d="M0,0 L8,4 L0,8 Z" class="ill-arrowhead"></path>
    </marker>
  </defs>

  <g>
    <rect x="10" y="28" width="90" height="88" class="ill-box"></rect>
    <text x="18" y="41" class="ill-kicker">INPUT · miRNA LIST</text>
    <text x="18" y="57" class="ill-mono">hsa-miR-28</text>
    <text x="18" y="69" class="ill-mono">hsa-miR-13</text>
    <text x="18" y="81" class="ill-mono">hsa-miR-528</text>
    <text x="18" y="93" class="ill-mono-muted">+12 more</text>

    <line x1="100" y1="72" x2="120" y2="72" class="ill-line" marker-end={`url(#arrow-${name})`}></line>

    <rect x="122" y="14" width="66" height="116" class="ill-box-strong"></rect>
    <g class="ill-corner">
      <path d="M118,16 h6 M120,10 v6" />
      <path d="M192,16 h-6 M190,10 v6" />
      <path d="M118,128 h6 M120,134 v-6" />
      <path d="M192,128 h-6 M190,134 v-6" />
    </g>
    <text x="155" y="60" text-anchor="middle" class="ill-title">CORALIS</text>
    <text x="155" y="73" text-anchor="middle" class="ill-kicker">ENRICHMENT</text>
    <line x1="132" y1="82" x2="178" y2="82" class="ill-line-muted"></line>
    <text x="155" y="98" text-anchor="middle" class="ill-mono-muted">validated</text>
    <text x="155" y="108" text-anchor="middle" class="ill-mono-muted">miRNA–target DB</text>

    <line x1="188" y1="72" x2="206" y2="72" class="ill-line" marker-end={`url(#arrow-${name})`}></line>

    <g>
      <rect x="210" y="18" width="20" height="20" class="ill-box"></rect>
      <rect x="215" y="30" width="3" height="5" class="ill-bar"></rect>
      <rect x="220" y="26" width="3" height="9" class="ill-bar"></rect>
      <rect x="225" y="22" width="3" height="13" class="ill-bar"></rect>
      <text x="238" y="31" class="ill-mono">Pathways</text>

      <rect x="210" y="56" width="20" height="20" class="ill-box"></rect>
      <circle cx="216" cy="70" r="2" class="ill-dot"></circle>
      <circle cx="226" cy="63" r="2" class="ill-dot"></circle>
      <circle cx="226" cy="75" r="2" class="ill-dot"></circle>
      <line x1="216" y1="70" x2="226" y2="63" class="ill-line-thin"></line>
      <line x1="216" y1="70" x2="226" y2="75" class="ill-line-thin"></line>
      <text x="238" y="69" class="ill-mono">Network</text>

      <rect x="210" y="94" width="20" height="20" class="ill-box"></rect>
      <line x1="210" y1="104" x2="230" y2="104" class="ill-line-thin"></line>
      <line x1="220" y1="94" x2="220" y2="114" class="ill-line-thin"></line>
      <text x="238" y="107" class="ill-mono">Table</text>
    </g>
  </g>
</svg>

<style>
  .card-illustration {
    display: block;
  }
  .ill-box {
    fill: none;
    stroke: var(--color-divider);
    stroke-width: 1;
  }
  .ill-box-strong {
    fill: none;
    stroke: var(--color-accent);
    stroke-width: 1.2;
  }
  .ill-corner path {
    fill: none;
    stroke: color-mix(in srgb, var(--color-text) 55%, transparent);
    stroke-width: 1;
  }
  .ill-line {
    stroke: var(--color-accent);
    stroke-width: 1.2;
    fill: none;
  }
  .ill-line-thin {
    stroke: var(--color-accent-500);
    stroke-width: 1;
    fill: none;
  }
  .ill-line-muted {
    stroke: var(--color-divider);
    stroke-width: 1;
    fill: none;
  }
  .ill-arrowhead { fill: var(--color-accent); }
  .ill-dot { fill: var(--color-accent); }
  .ill-bar { fill: var(--color-accent-300); }
  .ill-kicker {
    font: 400 6.5px/1 ui-monospace, Menlo, monospace;
    letter-spacing: 0.08em;
    fill: var(--color-accent);
    text-transform: uppercase;
  }
  .ill-mono {
    font: 400 7px/1 ui-monospace, Menlo, monospace;
    fill: var(--color-neutral-700);
  }
  .ill-mono-muted {
    font: 400 6.5px/1 ui-monospace, Menlo, monospace;
    fill: var(--color-neutral-600);
  }
  .ill-title {
    font: 600 12px/1 var(--font-heading);
    fill: var(--color-text);
  }
</style>
