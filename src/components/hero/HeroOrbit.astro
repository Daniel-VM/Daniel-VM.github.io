---
import { heroCopy, offers, type Lang } from '../../data/profile';
interface Props { lang: Lang }
const { lang } = Astro.props;
const chips = ['Nextflow', 'HPC', 'OMOP', 'APIs', 'Agents', 'nf-core'];
---
<section class="orbit-hero">
  <div class="top">
    <div>
      <p class="kick">Daniel V. Millares · PhD</p>
      <h1>{heroCopy.title[lang][0]} <span>{heroCopy.title[lang][1]}</span></h1>
      <p class="lead">{heroCopy.lead[lang]}</p>
      <div class="ctas">
        <a class="btn btn-primary" href="https://www.linkedin.com/in/daniel-v-millares-239b27185/" target="_blank" rel="noopener">LinkedIn ↗</a>
        <a class="btn btn-secondary" href="#proyectos">{lang === 'es' ? 'Proyectos' : 'Projects'}</a>
      </div>
    </div>
    <div class="photo-wrap" aria-hidden="false">
      <svg class="rings" viewBox="0 0 400 400" aria-hidden="true">
        <g class="r1"><circle cx="200" cy="200" r="190" /><circle cx="390" cy="200" r="7" fill="#31958f" /><circle cx="10" cy="200" r="5" fill="#e08a3c" /></g>
        <g class="r2"><circle cx="200" cy="200" r="168" /><circle cx="200" cy="32" r="6" fill="#7b5ea7" /></g>
        <g class="r3"><circle cx="200" cy="200" r="150" /><circle cx="200" cy="350" r="5" fill="#6f7d95" /></g>
      </svg>
      <img src="/assets/profile.png" alt="Daniel V. Millares" />
      {chips.map((c, i) => <span class="chip" style={`--a:${i * 60}deg`}>{c}</span>)}
    </div>
  </div>
  <h2 class="offer-title">{heroCopy.offerTitle[lang]}</h2>
  <div class="offers">
    {offers.map((o) => (
      <a class="offer" href={o.href} style={`--c:${o.color}`}>
        <h3>{o.title[lang]}</h3>
        <p>{o.text[lang]}</p>
        <small>{o.proof[lang]}</small>
      </a>
    ))}
  </div>
</section>
<style>
  .orbit-hero { padding: 48px 0 36px; }
  .top { display: grid; grid-template-columns: minmax(0, 1fr) 400px; gap: 40px; align-items: center; }
  .kick { font: 400 11px/1 ui-monospace, Menlo, monospace; letter-spacing: .18em; text-transform: uppercase; color: var(--color-accent); margin: 0 0 16px; }
  h1 { font-size: clamp(34px, 4.4vw, 58px); line-height: 1.02; letter-spacing: -.02em; margin: 0 0 18px; text-wrap: balance; }
  h1 span { color: var(--color-accent); }
  .lead { max-width: 58ch; font-size: 16.5px; line-height: 1.6; color: var(--color-neutral-800); margin: 0 0 22px; }
  .ctas { display: flex; gap: 12px; flex-wrap: wrap; }
  .ctas .btn { padding: 12px 20px; font-size: 14px; letter-spacing: .06em; text-transform: uppercase; }
  .photo-wrap { position: relative; width: 400px; height: 400px; }
  .photo-wrap img { position: absolute; inset: 70px; width: 260px; height: 260px; border-radius: 50%; object-fit: cover; object-position: 50% 25%; box-shadow: 0 20px 50px -20px #0b1a2b; }
  .rings { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .rings circle:first-child { fill: none; stroke: var(--color-divider); stroke-width: 1.2; stroke-dasharray: 4 6; }
  .rings g { transform-origin: 200px 200px; }
  .r1 { animation: spin 38s linear infinite; }
  .r2 { animation: spin 26s linear infinite reverse; }
  .r3 { animation: spin 18s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .chip {
    position: absolute; left: 50%; top: 50%;
    transform: rotate(var(--a)) translate(196px) rotate(calc(-1 * var(--a))) translate(-50%, -50%);
    font: 500 11px/1 ui-monospace, Menlo, monospace; letter-spacing: .06em;
    background: var(--color-bg); border: 1px solid var(--color-divider); padding: 6px 9px; white-space: nowrap;
    animation: bob 4s ease-in-out infinite; animation-delay: calc(var(--a) / 60deg * -0.6s);
  }
  @keyframes bob { 50% { margin-top: -6px; } }
  .offer-title { font: 400 11px/1 ui-monospace, Menlo, monospace; letter-spacing: .18em; text-transform: uppercase; color: var(--color-neutral-700); margin: 40px 0 14px; }
  .offers { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 14px; }
  .offer { display: flex; flex-direction: column; gap: 8px; padding: 18px; border: 1px solid var(--color-divider-soft); border-top: 4px solid var(--c); background: color-mix(in srgb, var(--color-bg) 60%, #fff); color: var(--color-text); transition: transform var(--duration) var(--ease), box-shadow var(--duration) var(--ease); }
  .offer:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .offer h3 { margin: 0; font-size: 21px; }
  .offer p { margin: 0; font-size: 14px; line-height: 1.5; color: var(--color-neutral-800); }
  .offer small { margin-top: auto; font: 400 11px/1.3 ui-monospace, Menlo, monospace; color: var(--c); }
  @media (max-width: 860px) { .top { grid-template-columns: 1fr; } .photo-wrap { transform: scale(.8); transform-origin: left top; height: 330px; } }
  @media (prefers-reduced-motion: reduce) { .rings g, .chip { animation: none; } }
</style>
