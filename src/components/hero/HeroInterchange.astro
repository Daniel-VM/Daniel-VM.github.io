---
import { heroCopy, offers, type Lang } from '../../data/profile';
interface Props { lang: Lang }
const { lang } = Astro.props;
const left = offers.slice(0, 2), right = offers.slice(2);
// line endpoints in a 0-100 box: cards sit at y=25/75, the photo at the centre
const paths = [
  { d: 'M30 25 C 40 25, 40 50, 50 50', c: offers[0].color },
  { d: 'M30 75 C 40 75, 40 50, 50 50', c: offers[1].color },
  { d: 'M70 25 C 60 25, 60 50, 50 50', c: offers[2].color },
  { d: 'M70 75 C 60 75, 60 50, 50 50', c: offers[3].color },
];
---
<section class="ix">
  <p class="kick">Daniel V. Millares · PhD · Platform Tech Lead</p>
  <h1>{heroCopy.title[lang][0]}<br /><span>{heroCopy.title[lang][1]}</span></h1>
  <p class="lead">{heroCopy.lead[lang]}</p>

  <div class="board">
    <svg class="wires" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      {paths.map((p, i) => (
        <>
          <path d={p.d} stroke={p.c} class="base" />
          <path d={p.d} stroke={p.c} class="pulse" style={`animation-delay:${i * -0.7}s`} />
        </>
      ))}
    </svg>
    <div class="col">
      {left.map((o) => (
        <a class="card" href={o.href} style={`--c:${o.color}`}><i></i><h3>{o.title[lang]}</h3><p>{o.text[lang]}</p><small>{o.proof[lang]}</small></a>
      ))}
    </div>
    <div class="hub">
      <div class="ring"></div>
      <img src="/assets/profile.png" alt="Daniel V. Millares" />
    </div>
    <div class="col">
      {right.map((o) => (
        <a class="card right" href={o.href} style={`--c:${o.color}`}><i></i><h3>{o.title[lang]}</h3><p>{o.text[lang]}</p><small>{o.proof[lang]}</small></a>
      ))}
    </div>
  </div>
  <div class="ctas">
    <a class="btn btn-primary" href="https://www.linkedin.com/in/daniel-v-millares-239b27185/" target="_blank" rel="noopener">LinkedIn ↗</a>
    <a class="btn btn-secondary" href="#proyectos">{lang === 'es' ? 'Proyectos' : 'Projects'}</a>
  </div>
</section>
<style>
  .ix { padding: 52px 0 36px; text-align: center; }
  .kick { font: 400 11px/1 ui-monospace, Menlo, monospace; letter-spacing: .18em; text-transform: uppercase; color: var(--color-accent); margin: 0 0 16px; }
  h1 { font-size: clamp(34px, 4.6vw, 60px); line-height: 1.02; letter-spacing: -.02em; margin: 0 auto 16px; max-width: 28ch; text-wrap: balance; }
  h1 span { color: var(--color-accent); }
  .lead { max-width: 64ch; margin: 0 auto 34px; font-size: 16.5px; line-height: 1.6; color: var(--color-neutral-800); }
  .board { position: relative; display: grid; grid-template-columns: 1fr 280px 1fr; gap: 0 40px; align-items: center; text-align: left; }
  .wires { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 0; }
  .wires path { fill: none; vector-effect: non-scaling-stroke; }
  .base { stroke-width: 6; opacity: .9; stroke-linecap: round; }
  .pulse { stroke: #fff !important; stroke-width: 2.5; stroke-dasharray: 3 40; stroke-linecap: round; animation: flow 2.8s linear infinite; }
  @keyframes flow { to { stroke-dashoffset: -43; } }
  .col { position: relative; z-index: 1; display: grid; gap: 26px; }
  .card { display: flex; flex-direction: column; gap: 7px; padding: 16px 18px; background: var(--color-bg); border: 1px solid var(--color-divider-soft); border-left: 5px solid var(--c); color: var(--color-text); transition: transform var(--duration) var(--ease), box-shadow var(--duration) var(--ease); }
  .card.right { border-left: 1px solid var(--color-divider-soft); border-right: 5px solid var(--c); }
  .card:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); }
  .card h3 { margin: 0; font-size: 20px; }
  .card p { margin: 0; font-size: 13.5px; line-height: 1.5; color: var(--color-neutral-800); }
  .card small { font: 400 11px/1.3 ui-monospace, Menlo, monospace; color: var(--c); }
  .hub { position: relative; z-index: 1; width: 280px; height: 280px; display: grid; place-items: center; }
  .ring { position: absolute; inset: 0; border-radius: 50%; background: conic-gradient(#e08a3c 0 25%, #31958f 0 50%, #6f7d95 0 75%, #7b5ea7 0); animation: spin 14s linear infinite; }
  .ring::after { content: ''; position: absolute; inset: 9px; border-radius: 50%; background: var(--color-bg); }
  .hub img { position: relative; width: 246px; height: 246px; border-radius: 50%; object-fit: cover; object-position: 50% 22%; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .ctas { display: flex; gap: 12px; justify-content: center; margin-top: 30px; }
  .ctas .btn { padding: 12px 20px; font-size: 14px; letter-spacing: .06em; text-transform: uppercase; }
  @media (max-width: 900px) {
    .board { grid-template-columns: 1fr; gap: 20px; }
    .wires { display: none; }
    .hub { order: -1; margin: 0 auto; width: 220px; height: 220px; } .hub img { width: 196px; height: 196px; }
  }
  @media (prefers-reduced-motion: reduce) { .ring, .pulse { animation: none; } }
</style>
