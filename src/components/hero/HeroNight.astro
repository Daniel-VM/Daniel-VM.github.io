---
import { heroCopy, offers, type Lang } from '../../data/profile';
interface Props { lang: Lang }
const { lang } = Astro.props;
const flows = [
  { y: 70, c: '#31958f', d: 14 }, { y: 150, c: '#e08a3c', d: 18 }, { y: 230, c: '#7b5ea7', d: 11 }, { y: 310, c: '#6f7d95', d: 22 },
];
---
<section class="night">
  <svg class="flow" viewBox="0 0 1400 380" preserveAspectRatio="none" aria-hidden="true">
    {flows.map((f, i) => (
      <path d={`M-20 ${f.y} C 300 ${f.y - 40}, 600 ${f.y + 50}, 900 ${f.y} S 1300 ${f.y - 30}, 1420 ${f.y}`} stroke={f.c} style={`--d:${f.d}s`} />
    ))}
  </svg>
  <div class="inner">
    <div class="text">
      <p class="kick">Daniel V. Millares · PhD · Platform Tech Lead</p>
      <h1>{heroCopy.title[lang][0]} <span>{heroCopy.title[lang][1]}</span></h1>
      <p class="lead">{heroCopy.lead[lang]}</p>
      <div class="ctas">
        <a class="cta solid" href="https://www.linkedin.com/in/daniel-v-millares-239b27185/" target="_blank" rel="noopener">LinkedIn ↗</a>
        <a class="cta" href="#proyectos">{lang === 'es' ? 'Proyectos' : 'Projects'}</a>
      </div>
    </div>
    <figure class="arch"><img src="/assets/profile.png" alt="Daniel V. Millares" /></figure>
  </div>
  <div class="offers">
    <p class="offer-title">{heroCopy.offerTitle[lang]}</p>
    <ol>
      {offers.map((o, i) => (
        <li style={`--c:${o.color}`}>
          <a href={o.href}>
            <span class="n">0{i + 1}</span>
            <strong>{o.title[lang]}</strong>
            <span class="t">{o.text[lang]}</span>
            <em>{o.proof[lang]}</em>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .night { position: relative; overflow: hidden; margin: 0 calc(50% - 50vw); padding: 64px max(28px, calc(50vw - 562px)) 40px; background: radial-gradient(90% 120% at 85% 10%, #1b3047 0%, #0c1522 60%); color: #eef2f6; }
  .flow { position: absolute; inset: 0; width: 100%; height: 380px; opacity: .55; }
  .flow path { fill: none; stroke-width: 2.5; stroke-dasharray: 2 14; stroke-linecap: round; animation: run var(--d) linear infinite; }
  @keyframes run { to { stroke-dashoffset: -320; } }
  .inner { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) 320px; gap: 48px; align-items: end; }
  .kick { font: 400 11px/1 ui-monospace, Menlo, monospace; letter-spacing: .18em; text-transform: uppercase; color: #94bce3; margin: 0 0 16px; }
  h1 { font-size: clamp(36px, 4.8vw, 64px); line-height: 1; letter-spacing: -.02em; margin: 0 0 18px; color: #fff; text-wrap: balance; }
  h1 span { background: linear-gradient(90deg, #31958f, #94bce3 45%, #7b5ea7); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lead { max-width: 58ch; font-size: 16.5px; line-height: 1.6; color: #c9d4df; margin: 0 0 24px; }
  .ctas { display: flex; gap: 12px; }
  .cta { padding: 12px 20px; border: 1px solid #ffffff55; color: #fff; font: 600 14px/1 var(--font-heading); letter-spacing: .08em; text-transform: uppercase; transition: background var(--duration) var(--ease); }
  .cta.solid { background: #fff; color: #0c1522; border-color: #fff; }
  .cta:hover { background: #ffffff1a; } .cta.solid:hover { background: #dce8f3; }
  .arch { margin: 0; height: 400px; border-radius: 999px 999px 18px 18px; overflow: hidden; border: 1px solid #ffffff2a; box-shadow: 0 30px 60px -30px #000; position: relative; }
  .arch img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 20%; }
  .arch::after { content: ''; position: absolute; inset: auto 0 0 0; height: 35%; background: linear-gradient(transparent, #0c1522cc); }
  .offers { position: relative; margin-top: 44px; border-top: 1px solid #ffffff22; padding-top: 18px; }
  .offer-title { font: 400 11px/1 ui-monospace, Menlo, monospace; letter-spacing: .18em; text-transform: uppercase; color: #94bce3; margin: 0 0 14px; }
  ol { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 0; }
  li { border-left: 1px solid #ffffff1f; }
  li a { display: flex; flex-direction: column; gap: 7px; padding: 6px 18px 10px; color: inherit; height: 100%; transition: background var(--duration) var(--ease); }
  li a:hover { background: #ffffff0d; }
  .n { font: 600 13px/1 ui-monospace, Menlo, monospace; color: var(--c); }
  strong { font: 600 21px/1.15 var(--font-heading); color: #fff; }
  .t { font-size: 13.5px; line-height: 1.5; color: #b8c4d0; }
  em { font: normal 400 11px/1.3 ui-monospace, Menlo, monospace; color: var(--c); margin-top: auto; }
  @media (max-width: 860px) { .inner { grid-template-columns: 1fr; } .arch { height: 300px; max-width: 260px; } }
  @media (prefers-reduced-motion: reduce) { .flow path { animation: none; } }
</style>
