---
import MetroMap from './MetroMap.astro';
import type { Lang } from '../data/profile';

interface Props {
  dict: ReturnType<typeof import('../i18n/ui').t>;
  lang: Lang;
}

const { dict, lang } = Astro.props;
---

<section class="hero" style="padding:56px 0 40px">
  <div class="reveal hero-top">
    <div>
      <p style="font:400 11px/1 ui-monospace,Menlo,monospace;letter-spacing:.18em;text-transform:uppercase;color:var(--color-accent);margin:0 0 18px">
        {dict.kicker}
      </p>
      <h1 style="font-size:clamp(36px,4.8vw,62px);line-height:1;letter-spacing:-.02em;margin:0 0 18px;text-wrap:balance">
        {dict.heroA}<br /><span style="color:var(--color-accent)">{dict.heroB}</span>
      </h1>
      <p style="max-width:62ch;font-size:16.5px;line-height:1.6;color:var(--color-neutral-800);margin:0 0 24px;text-wrap:pretty">
        {dict.heroP}
      </p>
      <div class="flex flex-wrap items-stretch gap-3">
        <a
          class="btn btn-primary blueprint"
          href="https://www.linkedin.com/in/daniel-v-millares-239b27185/"
          target="_blank"
          rel="noopener"
          style="padding:12px 20px;font-size:14px;letter-spacing:.06em;text-transform:uppercase;height:auto"
        >
          <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
          {dict.cta3} ↗
        </a>
        <a class="btn btn-secondary" href="#proyectos" style="padding:12px 20px;font-size:14px;letter-spacing:.06em;text-transform:uppercase;height:auto">
          {dict.cta1}
        </a>
        <a class="btn btn-secondary" href="#trayectoria" style="padding:12px 20px;font-size:14px;letter-spacing:.06em;text-transform:uppercase;height:auto">
          {dict.cta2}
        </a>
      </div>
    </div>
    <div class="hero-side">
      <figure class="blueprint" style="position:relative;aspect-ratio:1/1;overflow:hidden;background:var(--color-neutral-100);margin:0">
        <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
        <div class="duotone" style="width:100%;height:100%">
          <img
            src="/assets/profile.png"
            alt="Daniel V. Millares"
            style="width:100%;height:100%;object-fit:cover;object-position:50% 22%;display:block"
          />
        </div>
      </figure>
      <p style="font:400 11.5px/1.7 ui-monospace,Menlo,monospace;color:var(--color-neutral-700);margin:0;border-left:1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);padding-left:12px">
        {dict.nowNote}
      </p>
    </div>
  </div>

  <div class="blueprint metro-frame">
    <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
    <MetroMap lang={lang} caption={dict.metroCaption} />
    <p class="metro-hint">{dict.metroCaption}</p>
  </div>
</section>

<style>
  .hero-top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 44px;
    align-items: end;
    margin-bottom: 40px;
  }
  .hero-side { display: flex; flex-direction: column; gap: 14px; }
  @media (max-width: 760px) {
    .hero-top { grid-template-columns: 1fr; }
    .hero-side { max-width: 220px; }
  }
  .metro-frame {
    position: relative;
    padding: 18px 20px 16px;
    background: color-mix(in srgb, var(--color-bg) 70%, #fff);
  }
  .metro-hint {
    margin: 8px 0 0;
    font: 400 10.5px/1.4 ui-monospace, Menlo, monospace;
    letter-spacing: .06em;
    color: var(--color-neutral-600);
  }
</style>
