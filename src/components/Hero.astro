---
interface Props {
  dict: ReturnType<typeof import('../i18n/ui').t>;
}

const { dict } = Astro.props;
---

<section
  class="reveal"
  style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,330px),1fr));gap:44px;align-items:end;padding:64px 0 52px"
>
  <div>
    <p style="font:400 11px/1 ui-monospace,Menlo,monospace;letter-spacing:.18em;text-transform:uppercase;color:var(--color-accent);margin:0 0 18px">
      {dict.kicker}
    </p>
    <h1 style="font-size:clamp(40px,5.4vw,70px);line-height:.98;letter-spacing:-.02em;margin:0 0 18px;text-wrap:balance">
      {dict.heroA}<br /><span style="color:var(--color-accent)">{dict.heroB}</span>
    </h1>
    <p style="max-width:52ch;font-size:16.5px;line-height:1.6;color:var(--color-neutral-800);margin:0 0 26px;text-wrap:pretty">
      {dict.heroP}
    </p>
    <div class="flex flex-wrap items-stretch gap-3" style="margin-bottom:34px">
      <a
        class="btn btn-primary blueprint"
        href="https://www.linkedin.com/in/daniel-v-millares-239b27185/"
        target="_blank"
        rel="noopener"
        style="padding:12px 20px;font-size:14px;letter-spacing:.06em;text-transform:uppercase;height:auto"
      >
        <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
        {dict.cta3} ↗
      </a>
      <a class="btn btn-secondary" href="#servicios" style="padding:12px 20px;font-size:14px;letter-spacing:.06em;text-transform:uppercase;height:auto">
        {dict.cta1}
      </a>
      <a class="btn btn-secondary" href="#trayectoria" style="padding:12px 20px;font-size:14px;letter-spacing:.06em;text-transform:uppercase;height:auto">
        {dict.cta2}
      </a>
    </div>
    <div class="blueprint" style="display:grid;grid-template-columns:repeat(3,minmax(0,1fr));background:transparent">
      <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
      {dict.stats.map(([n, l], i) => (
        <div
          class="kpi-cell"
          style={`padding:13px 15px;border-right:1px solid var(--color-divider-soft);${
            i > 2 ? 'border-top:1px solid var(--color-divider-soft)' : ''
          }`}
        >
          <div style="font:600 27px/1 var(--font-heading);color:var(--color-text)">{n}</div>
          <div style="font:400 10px/1.3 ui-monospace,Menlo,monospace;letter-spacing:.07em;text-transform:uppercase;color:var(--color-neutral-700);margin-top:6px">
            {l}
          </div>
        </div>
      ))}
    </div>
  </div>
  <div style="display:flex;flex-direction:column;gap:16px;max-width:300px;margin-left:auto;width:100%">
    <div style="position:relative">
      <div class="portrait-glow" aria-hidden="true"></div>
      <figure class="blueprint" style="position:relative;z-index:1;aspect-ratio:1/1;overflow:hidden;background:var(--color-neutral-100)">
        <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
        <div class="duotone" style="width:100%;height:100%">
          <img
            src="/assets/profile.png"
            alt="Daniel V. Millares"
            style="width:100%;height:100%;object-fit:cover;object-position:50% 22%;display:block"
          />
        </div>
      </figure>
    </div>
    <p style="font:400 11.5px/1.7 ui-monospace,Menlo,monospace;color:var(--color-neutral-700);margin:0;border-left:1px solid color-mix(in srgb, var(--color-accent) 45%, transparent);padding-left:12px">
      {dict.nowNote}
    </p>
  </div>
</section>

<style>
  .portrait-glow {
    position: absolute;
    z-index: 0;
    inset: -18px -18px auto auto;
    width: 62%;
    aspect-ratio: 1 / 1;
    background: radial-gradient(circle, color-mix(in srgb, var(--color-accent) 55%, transparent) 0%, transparent 70%);
    filter: blur(28px);
  }
</style>
