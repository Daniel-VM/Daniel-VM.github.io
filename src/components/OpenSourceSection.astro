---
import { getCollection } from 'astro:content';
import SectionKicker from './SectionKicker.astro';
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  dict: ReturnType<typeof import('../i18n/ui').t>;
}

const { locale, dict } = Astro.props;
const es = locale === 'es';

const os = (await getCollection('opensource')).sort((a, b) => a.id.localeCompare(b.id));
---

<section id="open-source" class="reveal" style="padding:56px 0;border-top:1px solid var(--color-divider)">
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,290px),1fr));gap:44px;align-items:start">
    <div style="position:sticky;top:96px">
      <SectionKicker n="04" label={dict.navOS} />
      <h2 style="font-size:clamp(28px,3.2vw,40px);margin:0 0 12px;letter-spacing:-.015em">{dict.osTitle}</h2>
      <p style="font-size:14.5px;line-height:1.6;color:var(--color-neutral-700);margin:0">{dict.osSub}</p>
    </div>
    <div class="blueprint" style="overflow-x:auto">
      <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
      <table class="table" style="min-width:520px">
        <thead>
          <tr>
            <th class="table-head" style="width:23%;padding:10px 16px">{dict.thProject}</th>
            <th class="table-head" style="padding:10px 16px">{dict.thRole}</th>
            <th class="table-head" style="width:16%;padding:10px 16px">{dict.thLink}</th>
          </tr>
        </thead>
        <tbody>
          {os.map((o) => (
            <tr class="os-row">
              <td style="padding:14px 16px">
                <div style="font:600 17px/1.15 var(--font-heading)">{o.data.name}</div>
                <div style="font:400 10.5px/1 ui-monospace,Menlo,monospace;color:var(--color-neutral-600);margin-top:4px">{o.data.kind}</div>
              </td>
              <td style="padding:14px 16px;font-size:13.5px;line-height:1.5;color:var(--color-neutral-800)">
                {es ? o.data.textEs : o.data.textEn}
              </td>
              <td style="padding:14px 16px">
                <a
                  href={o.data.link}
                  target="_blank"
                  rel="noopener"
                  class="os-link"
                  style="font:400 11.5px/1 ui-monospace,Menlo,monospace;color:var(--color-accent-700);border-bottom:1px solid color-mix(in srgb, var(--color-accent-700) 30%, transparent);white-space:nowrap"
                >
                  {o.data.host} ↗
                </a>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .os-link:hover { color: var(--color-accent) !important; border-color: var(--color-accent) !important; }
  .table-head {
    text-align: left;
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent-700);
    border-bottom: 2px solid var(--color-accent) !important;
  }
  .os-row td {
    border-bottom: 1px solid var(--color-divider-faint);
    transition: background 0.15s;
  }
  .os-row:last-child td { border-bottom: none; }
  .os-row:hover td { background: color-mix(in srgb, var(--color-accent) 5%, transparent); }
</style>
