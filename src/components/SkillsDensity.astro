---
import SectionKicker from './SectionKicker.astro';
import { skills, families, type Family, type Lang } from '../data/profile';

interface Props {
  lang: Lang;
  n: string;
  kicker: string;
  title: string;
  levels: readonly [string, string, string];
  keywords: readonly { label: string; items: string }[];
}
const { lang, n, kicker, title, levels, keywords } = Astro.props;

// Gaussian density, peak at basic (20), advanced (60) or expert (100) on a 0–120 axis.
const W = 120, H = 30, BASE = 29, SIGMA = 14;
function curve(level: 1 | 2 | 3) {
  const mu = [20, 60, 100][level - 1];
  const pts: string[] = [];
  for (let x = 0; x <= W; x += 2) {
    const y = BASE - (BASE - 3) * Math.exp(-((x - mu) ** 2) / (2 * SIGMA ** 2));
    pts.push(`${x} ${y.toFixed(2)}`);
  }
  return { area: `M0 ${BASE} L${pts.join(' L')} L${W} ${BASE} Z`, line: `M${pts.join(' L')}`, mu };
}
const order: Family[] = ['compute', 'data', 'ai'];
---

<section id="stack" class="reveal skills" style="max-width:1180px;margin:0 auto;padding:60px 28px 20px">
  <SectionKicker n={n} label={kicker} />
  <h2 style="font-size:clamp(30px,3.6vw,44px);margin:0 0 28px;letter-spacing:-.015em">{title}</h2>

  <div class="skill-grid">
    {order.map((fam) => (
      <div class="skill-col">
        <h6 style={`color:${families[fam].color}`}><span style={`background:${families[fam].color}`}></span>{families[fam].name[lang]}</h6>
        <div class="axis" aria-hidden="true"><span>{levels[0]}</span><span>{levels[1]}</span><span>{levels[2]}</span></div>
        <ul>
          {skills.filter((s) => s.family === fam).map((s, i) => {
            const c = curve(s.level);
            return (
              <li class="skill" style={`--c:${families[fam].color};--d:${i * 90}ms`}>
                <span class="skill-name">{s.name}</span>
                <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label={`${s.name}: ${levels[s.level - 1]}`}>
                  <line x1="0" x2={W} y1={BASE + 0.5} y2={BASE + 0.5} class="track" />
                  <line x1="60" x2="60" y1="4" y2={BASE} class="tick" />
                  <path d={c.area} class="area" />
                  <path d={c.line} class="ridge" />
                </svg>
                <span class="skill-level">{levels[s.level - 1]}</span>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </div>

  <dl class="keywords">
    {keywords.map((k) => (
      <div><dt>{k.label}</dt><dd>{k.items}</dd></div>
    ))}
  </dl>
</section>

<style>
  .skill-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 28px 40px; }
  .skill-col h6 {
    display: flex; align-items: center; gap: 10px; margin: 0 0 6px;
    font-size: 12px; letter-spacing: .12em; text-transform: uppercase;
  }
  .skill-col h6 span { width: 22px; height: 5px; border-radius: 3px; }
  .axis {
    display: grid; grid-template-columns: repeat(3, 1fr); margin-left: 46%; margin-bottom: 4px;
    font: 400 9.5px/1 ui-monospace, Menlo, monospace; letter-spacing: .06em; text-transform: uppercase;
    color: var(--color-neutral-600);
  }
  .axis span { text-align: center; }
  ul { list-style: none; margin: 0; padding: 0; }
  .skill {
    display: grid; grid-template-columns: 46% 1fr; align-items: end; gap: 0;
    padding: 5px 0; border-bottom: 1px solid var(--color-divider-faint); position: relative;
  }
  .skill-name { font-size: 14.5px; padding-bottom: 4px; }
  .skill svg { width: 100%; height: 30px; overflow: visible; }
  .track { stroke: var(--color-neutral-400); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .tick { stroke: var(--color-divider); stroke-width: 1; stroke-dasharray: 2 3; vector-effect: non-scaling-stroke; }
  .area {
    fill: var(--c); opacity: .78;
    transform-origin: 50% 100%; transform-box: fill-box;
    transform: scaleY(0); animation: rise .9s var(--ease) forwards; animation-delay: var(--d);
    transition: opacity var(--duration) var(--ease);
  }
  .ridge { fill: none; stroke: var(--c); stroke-width: 1.5; vector-effect: non-scaling-stroke; opacity: 0; animation: fade .6s var(--ease) forwards; animation-delay: calc(var(--d) + .5s); }
  .area, .ridge { animation-play-state: paused; }
  .skills.in-view .area, .skills.in-view .ridge { animation-play-state: running; }
  @keyframes rise { to { transform: scaleY(1); } }
  @keyframes fade { to { opacity: 1; } }
  .skill-level {
    position: absolute; right: 0; top: 2px;
    font: 400 10px/1 ui-monospace, Menlo, monospace; letter-spacing: .06em; text-transform: uppercase;
    color: var(--c); opacity: 0; transition: opacity var(--duration) var(--ease);
  }
  .skill:hover .area { opacity: 1; }
  .skill:hover .skill-level { opacity: 1; }

  .keywords {
    margin: 34px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 12px 40px;
    font-size: 13.5px; line-height: 1.55; color: var(--color-neutral-800);
  }
  .keywords dt { font: 600 12px/1.2 var(--font-heading); letter-spacing: .1em; text-transform: uppercase; color: var(--color-accent-700); margin-bottom: 3px; }
  .keywords dd { margin: 0; }

  @media (prefers-reduced-motion: reduce) {
    .area { animation: none; transform: none; }
    .ridge { animation: none; opacity: 1; }
  }
</style>

<script>
  function initSkills() {
    const el = document.querySelector('.skills');
    if (!el) return;
    if (!('IntersectionObserver' in window)) { el.classList.add('in-view'); return; }
    const io = new IntersectionObserver((es) => {
      if (es.some((e) => e.isIntersecting)) { el.classList.add('in-view'); io.disconnect(); }
    }, { threshold: 0.25 });
    io.observe(el);
  }
  initSkills();
  document.addEventListener('astro:after-swap', initSkills);
</script>
