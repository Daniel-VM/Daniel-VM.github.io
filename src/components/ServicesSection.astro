---
import SectionKicker from './SectionKicker.astro';

interface Props {
  dict: ReturnType<typeof import('../i18n/ui').t>;
}

const { dict } = Astro.props;
---

<section
  id="servicios"
  style="background:radial-gradient(120% 140% at 12% -10%, color-mix(in srgb, var(--color-accent-700) 55%, var(--color-accent-900)) 0%, var(--color-accent-900) 55%);color:var(--color-bg);position:relative"
>
  <div class="reveal" style="max-width:1180px;margin:0 auto;padding:64px 28px">
    <div class="flex flex-wrap items-end justify-between gap-[30px]" style="margin-bottom:34px">
      <div>
        <SectionKicker n="02" label={dict.navSvc} dark />
        <h2 style="font-size:clamp(30px,3.8vw,48px);margin:0;letter-spacing:-.015em;color:var(--color-bg)">{dict.svcTitle}</h2>
      </div>
      <p style="max-width:42ch;font-size:14.5px;line-height:1.6;color:color-mix(in srgb, var(--color-bg) 72%, transparent);margin:0">
        {dict.svcSub}
      </p>
    </div>

    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(258px,1fr));gap:20px;margin-bottom:34px">
      {dict.svcs.map((s) => (
        <article
          class="blueprint svc-card"
          style="position:relative;border:1px solid color-mix(in srgb, var(--color-bg) 28%, transparent);color:color-mix(in srgb, var(--color-bg) 60%, transparent);padding:22px 20px;display:flex;flex-direction:column;gap:10px"
        >
          <i class="corner tl svc-corner"></i><i class="corner tr svc-corner"></i><i class="corner bl svc-corner"></i><i class="corner br svc-corner"></i>
          <div style="font:400 10.5px/1 ui-monospace,Menlo,monospace;letter-spacing:.14em;color:var(--color-accent-400)">{s.no}</div>
          <h3 style="font-size:23px;margin:0;color:var(--color-bg)">{s.title}</h3>
          <p style="font-size:13.5px;line-height:1.55;color:color-mix(in srgb, var(--color-bg) 78%, transparent);margin:0">{s.text}</p>
          <div class="flex flex-wrap gap-[6px]" style="margin-top:auto;padding-top:4px">
            {s.tags.map((tag) => (
              <span style="font:400 10.5px/1 ui-monospace,Menlo,monospace;letter-spacing:.05em;padding:5px 9px;border:1px solid color-mix(in srgb, var(--color-bg) 25%, transparent);color:color-mix(in srgb, var(--color-bg) 82%, transparent)">
                {tag}
              </span>
            ))}
          </div>
        </article>
      ))}
    </div>

    <div class="flex flex-wrap items-center gap-[14px]">
      <a
        class="btn blueprint"
        href="https://calendly.com/danielvmillares/presentacion-omilinx-dr-daniel-valle"
        target="_blank"
        rel="noopener"
        style="background:var(--color-bg);color:var(--color-accent-900);border-color:var(--color-bg);padding:13px 22px;font-size:14px;letter-spacing:.06em;text-transform:uppercase"
      >
        <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>
        {dict.svcCta}
      </a>
      <a
        class="btn"
        href="https://omilinx.tailc8ab8e.ts.net/"
        target="_blank"
        rel="noopener"
        style="border-color:color-mix(in srgb, var(--color-bg) 40%, transparent);color:var(--color-bg);padding:13px 22px;font-size:14px;letter-spacing:.06em;text-transform:uppercase"
      >
        omilinx.io ↗
      </a>
      <a
        class="btn"
        href="https://www.linkedin.com/in/daniel-v-millares-239b27185/"
        target="_blank"
        rel="noopener"
        style="border-color:color-mix(in srgb, var(--color-bg) 40%, transparent);color:var(--color-bg);padding:13px 22px;font-size:14px;letter-spacing:.06em;text-transform:uppercase"
      >
        LinkedIn ↗
      </a>
    </div>
  </div>
</section>

<style>
  .svc-corner { color: color-mix(in srgb, var(--color-bg) 65%, transparent); }
  .svc-card {
    transition: border-color var(--duration) var(--ease), background var(--duration) var(--ease), transform var(--duration) var(--ease), box-shadow var(--duration) var(--ease);
  }
  .svc-card:hover {
    border-color: var(--color-accent-400) !important;
    background: color-mix(in srgb, var(--color-bg) 5%, transparent);
    transform: translateY(-3px);
    box-shadow: 0 12px 28px -10px color-mix(in srgb, var(--color-neutral-900) 45%, transparent);
  }
</style>
