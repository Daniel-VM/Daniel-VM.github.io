---
import type { Locale } from '../i18n/ui';

interface Props {
  locale: Locale;
  dict: ReturnType<typeof import('../i18n/ui').t>;
}

const { locale, dict } = Astro.props;

const nav = [
  { id: 'proyectos', label: dict.navProj },
  { id: 'servicios', label: dict.navSvc },
  { id: 'trayectoria', label: dict.navRoad },
  { id: 'open-source', label: dict.navOS },
  { id: 'comunidad', label: dict.navCom },
  { id: 'stack', label: dict.navStack },
];
---

<header
  class="sticky top-0 z-40 border-b"
  style="backdrop-filter:blur(10px);background:color-mix(in srgb, var(--color-bg) 86%, transparent);border-color:var(--color-divider)"
>
  <div id="scroll-progress"></div>
  <nav class="nav-grid" style="max-width:1180px;margin:0 auto;padding:12px 28px">
    <a
      href="#top"
      class="nav-brand"
      style="grid-area:brand;display:flex;align-items:baseline;gap:9px;font-size:17px;letter-spacing:.01em;color:var(--color-text)"
    >
      <span style="display:inline-block;width:9px;height:9px;background:var(--color-accent)"></span>
      DANIEL V. MILLARES
      <span style="font:400 11px/1 ui-monospace,Menlo,monospace;color:var(--color-neutral-600);letter-spacing:.1em">PhD</span>
    </a>
    <div class="nav-links" style="grid-area:links">
      {nav.map((n) => (
        <a
          href={`#${n.id}`}
          data-nav-link={n.id}
          class="nav-link"
          style="font-family:var(--font-heading);font-size:15px;letter-spacing:.03em;text-transform:uppercase;padding:2px 0;color:var(--color-text)"
        >
          {n.label}
        </a>
      ))}
    </div>
    <div class="seg" style="grid-area:lang">
      <a
        href="/"
        data-lang-switch="en"
        aria-current={locale === 'en' ? 'page' : undefined}
        class="seg-opt"
        style="font:600 12px/1 var(--font-heading);letter-spacing:.08em;padding:6px 10px"
      >
        EN
      </a>
      <a
        href="/es/"
        data-lang-switch="es"
        aria-current={locale === 'es' ? 'page' : undefined}
        class="seg-opt"
        style="font:600 12px/1 var(--font-heading);letter-spacing:.08em;padding:6px 10px"
      >
        ES
      </a>
    </div>
  </nav>
</header>

<style>
  .nav-grid {
    display: grid;
    grid-template-columns: auto 1fr auto;
    grid-template-areas: "brand links lang";
    align-items: center;
    column-gap: 22px;
  }
  .nav-links {
    grid-area: links;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
  }
  @media (max-width: 860px) {
    .nav-grid {
      grid-template-columns: 1fr auto;
      grid-template-areas: "brand lang" "links links";
      row-gap: 12px;
    }
    .nav-links {
      flex-wrap: nowrap;
      overflow-x: auto;
      gap: 18px;
      -webkit-overflow-scrolling: touch;
      mask-image: linear-gradient(to right, black calc(100% - 24px), transparent 100%);
      -webkit-mask-image: linear-gradient(to right, black calc(100% - 24px), transparent 100%);
    }
  }
  .seg-opt[aria-current='page'] {
    background: var(--color-accent);
    color: var(--color-bg);
  }
  .nav-link {
    position: relative;
    white-space: nowrap;
    transition: color var(--duration) var(--ease);
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -3px;
    height: 1px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration) var(--ease);
  }
  .nav-link:hover,
  .nav-link[aria-current='page'] {
    color: var(--color-accent) !important;
  }
  .nav-link:hover::after,
  .nav-link[aria-current='page']::after {
    transform: scaleX(1);
  }
</style>
