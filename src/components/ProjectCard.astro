---
import type { CollectionEntry } from 'astro:content';
import type { Locale } from '../i18n/ui';
import CardIllustration from './CardIllustration.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  locale: Locale;
}

const { project, locale } = Astro.props;
const p = project.data;
const es = locale === 'es';

const org = es ? p.org : p.orgEn ?? p.org;
const title = es ? p.title : p.titleEn ?? p.title;
const text = es ? p.descriptionEs : p.descriptionEn;
const tags = es ? p.tagsEs : p.tagsEn;
const metric = es ? p.metricEs : p.metricEn;
const linkLabel = es ? p.linkLabelEs ?? p.linkLabelEn : p.linkLabelEn ?? p.linkLabelEs;
const placeholder = es ? p.media.placeholderEs : p.media.placeholderEn;
---

<article
  class="card blueprint fade-in project-card hover-lift"
  data-project-cats={p.cats.join(' ')}
  style="padding:20px;gap:11px"
>
  <i class="corner tl"></i><i class="corner tr"></i><i class="corner bl"></i><i class="corner br"></i>

  {p.media.kind === 'cover' && (
    <div class="media-box" style="height:144px;overflow:hidden;border:1px solid var(--color-divider-soft);background:var(--color-neutral-100)">
      <img
        class="media-img"
        src={`/assets/${p.media.src}`}
        alt=""
        loading="lazy"
        style={`width:100%;height:100%;object-fit:cover;object-position:${p.media.position ?? 'top center'};display:block`}
      />
    </div>
  )}
  {p.media.kind === 'contain' && (
    <div style="height:144px;overflow:hidden;border:1px solid var(--color-divider-soft);background:var(--color-bg);padding:12px">
      <img src={`/assets/${p.media.src}`} alt="" loading="lazy" style="width:100%;height:100%;object-fit:contain;display:block" />
    </div>
  )}
  {p.media.kind === 'duo' && (
    <div class="duotone media-box" style="height:144px;overflow:hidden;border:1px solid var(--color-divider-soft);background:var(--color-neutral-100)">
      <img class="media-img" src={`/assets/${p.media.src}`} alt="" loading="lazy" style="width:100%;height:100%;object-fit:cover;object-position:top center;display:block" />
    </div>
  )}
  {p.media.kind === 'video' && (
    <div class="media-box" style="height:144px;overflow:hidden;border:1px solid var(--color-divider-soft);background:var(--color-neutral-100)">
      <video class="media-img" src={`/assets/${p.media.src}`} data-autoplay autoplay muted loop playsinline style="width:100%;height:100%;object-fit:cover;display:block"></video>
    </div>
  )}
  {p.media.kind === 'placeholder' && (
    <div
      class="placeholder-hatch"
      style="height:144px;display:grid;place-items:center;border:1px solid var(--color-divider-soft);font:400 10px/1.5 ui-monospace,Menlo,monospace;letter-spacing:.07em;color:var(--color-neutral-700);text-align:center;padding:10px"
    >
      {placeholder}
    </div>
  )}
  {p.media.kind === 'illustration' && p.media.illustration && (
    <div style="height:144px;overflow:hidden;border:1px solid var(--color-divider-soft);background:var(--color-bg);padding:10px">
      <CardIllustration name={p.media.illustration} />
    </div>
  )}

  <div class="flex items-baseline justify-between gap-[10px]">
    <span class="card-kicker" style="font-size:10px;letter-spacing:.11em">{org}</span>
    <span style="font:400 11px/1 ui-monospace,Menlo,monospace;color:var(--color-neutral-600);flex:none">{p.years}</span>
  </div>
  <h3 class="card-title" style="font-size:20px;letter-spacing:-.005em">{title}</h3>
  <p class="card-body" style="font-size:13.5px;line-height:1.55;text-wrap:pretty">{text}</p>

  {metric && (
    <div style="margin-top:auto;padding-top:4px;font:400 11.5px/1.4 ui-monospace,Menlo,monospace;color:var(--color-accent-700);display:flex;gap:7px">
      <span style="color:var(--color-accent)">→</span>{metric}
    </div>
  )}

  <div class="flex flex-wrap gap-[6px]" style={`margin-top:${metric ? '0' : 'auto'}`}>
    {tags.map((tag) => (
      <span class="tag tag-accent" style="font-size:10.5px;letter-spacing:.05em;text-transform:uppercase;padding:3px 10px">{tag}</span>
    ))}
  </div>

  {p.link && (
    <a
      href={p.link}
      target="_blank"
      rel="noopener"
      style="font-family:var(--font-heading);font-size:13.5px;letter-spacing:.06em;text-transform:uppercase;color:var(--color-accent-700);border-bottom:1px solid color-mix(in srgb, var(--color-accent-700) 35%, transparent);align-self:flex-start;padding-bottom:1px;transition:color .2s,border-color .2s"
    >
      {linkLabel} ↗
    </a>
  )}
</article>

<style>
  .media-img {
    transition: transform 0.4s var(--ease);
  }
  .project-card:hover .media-img {
    transform: scale(1.05);
  }
  .project-card a:hover {
    color: var(--color-accent) !important;
    border-color: var(--color-accent) !important;
  }
</style>
