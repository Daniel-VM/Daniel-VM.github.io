---
import SectionKicker from './SectionKicker.astro';

interface Props {
  dict: ReturnType<typeof import('../i18n/ui').t>;
}

const { dict } = Astro.props;
---

<section id="stack" class="reveal" style="max-width:1180px;margin:0 auto;padding:60px 28px 20px">
  <SectionKicker n="06" label={dict.navStack} />
  <h2 style="font-size:clamp(30px,3.6vw,44px);margin:0 0 30px;letter-spacing:-.015em">{dict.stackTitle}</h2>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(232px,1fr));gap:1px;background:var(--color-divider-soft);border:1px solid var(--color-divider-soft)">
    {dict.stack.map((g) => (
      <div class="stack-group" style="background:var(--color-bg);padding:18px 18px 20px">
        <h6 style="margin:0 0 12px;color:var(--color-accent);font-size:11px;letter-spacing:.12em;text-transform:uppercase">{g.label}</h6>
        <div class="flex flex-wrap gap-[6px]">
          {g.items.map((i) => (
            <span class="stack-item" style="font:400 11.5px/1 ui-monospace,Menlo,monospace;padding:6px 9px;border:1px solid var(--color-divider);color:var(--color-neutral-900)">
              {i}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .stack-group {
    transition: background var(--duration) var(--ease);
  }
  .stack-group:hover {
    background: color-mix(in srgb, var(--color-accent) 4%, var(--color-bg));
  }
  .stack-item {
    transition: border-color var(--duration) var(--ease), color var(--duration) var(--ease), background var(--duration) var(--ease);
  }
  .stack-item:hover {
    border-color: var(--color-accent);
    color: var(--color-accent-700);
    background: var(--color-accent-100);
  }
</style>
